# --- PostgreSQL (source) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dvdrental
POSTGRES_PORT=5432

# --- Kafka (KRaft mode) ---
KAFKA_PORT=9092
# Any fixed value works; generated with `kafka-storage.sh random-uuid`.
KAFKA_CLUSTER_ID=pqNs3YbDRqWuURZQcOuZEQ

# --- Schema Registry ---
# 8085 rather than its 8081 default -- the Flink dashboard already uses 8081.
SCHEMA_REGISTRY_PORT=8085

# --- Kafka Connect ---
CONNECT_PORT=8083

# --- Flink ---
FLINK_UI_PORT=8081

# --- ClickHouse (destination) ---
CLICKHOUSE_DB=dvdrental
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- AKHQ ---
AKHQ_PORT=8080

# --- Load generator (keeps the pipeline streaming) ---
GENERATOR_INTERVAL_SECONDS=5
